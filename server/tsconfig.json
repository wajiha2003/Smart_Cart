{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",

    "lib": ["ES2022"],

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "moduleResolution": "node",

    "resolveJsonModule": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "types": ["node"],

    "baseUrl": "./src"
  },

  "include": ["src"],

  "exclude": [
    "node_modules",
    "dist"
  ]
}