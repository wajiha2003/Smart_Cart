# Server
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email (Nodemailer)
# Leave EMAIL_MODE=console during development - emails are logged to the terminal instead of sent.
# Switch to EMAIL_MODE=smtp and fill in credentials (Mailtrap for dev, Gmail SMTP for prod) to send real emails.
EMAIL_MODE=console
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SmartCart <no-reply@smartcart.com>"

# Frontend URL (used to build links in emails, e.g. password reset)
CLIENT_URL=http://localhost:5173
